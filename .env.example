# FlexCacheGen Configuration
# Copy this file to .env and fill in your values.

# API key for GPT-5-mini evaluation
API_KEY=your_api_key_here

# Root directory for models
# Expected structure:
#   ${MODEL_ROOT}/Qwen3-VL-8B-Instruct
#   ${MODEL_ROOT}/roberta-large
MODEL_ROOT=/data/lyc/models

# Root directory for datasets and outputs
# Expected structure:
#   ${DATASET_ROOT}/MLVU/MLVU
#   ${DATASET_ROOT}/Video-MME
DATASET_ROOT=/data1/lyc/datasets

# Root directory for generation/evaluation outputs
OUTPUT_ROOT=/data1/lyc/flexcachegen_outputs
